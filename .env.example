# devbox secrets — copy to `.env` and fill in real values. NEVER commit `.env`.
# Compose auto-loads this file; values are interpolated into the container env
# and referenced as $ENV_VAR by config files (e.g. config/pi/models.json).

# Pi → Meridian: any value works (Meridian authenticates via the Claude SDK,
# the apiKey is a placeholder by design).
MERIDIAN_PLACEHOLDER=x

# Web search tool (Tavily) — used by the future web_search adapter. Optional.
# TAVILY_API_KEY=tvly-...
