# devbox secrets — copy to `.env` and fill in real values. NEVER commit `.env`.
# Compose auto-loads this file; values are interpolated into the container env
# and referenced as $ENV_VAR by config files (e.g. config/pi/models.json).

# Optional: host path mounted as the agent's workspace. Defaults to the repo's
# parent dir (../), which is ~/Development for this repo's location.
# WORKSPACE=/Users/imkrasnyukov/Development
# USER_UID=501
# DEVBOX_MEM_LIMIT=6g
# DEVBOX_CPUS=3
# DIND_MEM_LIMIT=4g
# DIND_CPUS=2

# Web search tool (Tavily) — used by the future web_search adapter. Optional.
# TAVILY_API_KEY=tvly-...

# deepseek (pi default provider AND the dsh service's default agent model) —
# apiKey via models.json $DEEPSEEK_API_KEY / DSH env
# DEEPSEEK_API_KEY=sk-...

# Claude OAuth token for the meridian service — generate with `claude setup-token`
# (run inside the devbox), then paste here. NEVER commit.
CLAUDE_OAUTH_TOKEN=

# glab (GitLab CLI): host + token (api scope — dedicated, revocable)
# GITLAB_HOST=https://gitlab.example.com   # your work instance
# GITLAB_TOKEN=glpat-...

# GitHub: token + the host it authenticates. Both containers wire a git
# credential helper for $GITHUB_HOST at boot, so `git push` over HTTPS works
# from inside the box (agent pushes, e.g. this repo). Classic PAT needs `repo`;
# a fine-grained one needs Contents: read and write on the target repos.
# GITHUB_HOST=github.com
# GITHUB_TOKEN=github_pat_...

# --- DeepSeek Harness (dsh service) ---
# Permission mode for DSH agents (default mirrors the VPS deployment).
# DSH_PERMISSION_MODE=workspace-write
# Port published on host loopback for the dsh GUI (container always binds 3080).
# DSH_PORT=3080
# DSH_MEM_LIMIT=4g
# DSH_CPUS=2
# Only needed for non-loopback browser origins (e.g. a Tailscale URL). For
# http://127.0.0.1:3080 leave unset — loopback needs no trusted host.
# DSH_TRUSTED_HOST=your-host.your-tailnet.ts.net
# Redmine MCP (the cordis profile in dsh-config/profiles/web bridges the
# oxigen Redmine into DSH sessions via uvx mcp-redmine).
# REDMINE_URL=https://oxigen.oxinus.holdings
# REDMINE_API_KEY=
