#!/usr/bin/env bash
# Pre-commit guard: refuse commits that contain token-shaped secrets.
# Installed via `git config core.hooksPath .githooks`.
set -u

# token patterns: tavily, anthropic, aws, github PAT, slack, stripe, etc.
PATTERNS='tvly-[A-Za-z0-9_-]{10,}|sk-ant-[A-Za-z0-9_-]{10,}|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{20,}|gho_[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|sk_live_[A-Za-z0-9]{10,}'

if git diff --cached --name-only -z | xargs -0 -I{} sh -c 'git show :"$1" 2>/dev/null' _ {} | grep -qiE "$PATTERNS"; then
    echo "❌ pre-commit: staged content contains what looks like a secret token."
    echo "   Remove it (or use env placeholders like \$ENV_VAR) before committing."
    exit 1
fi

# also block known secret files outright
if git diff --cached --name-only | grep -qE '(^|/)\.env$|auth\.json$'; then
    echo "❌ pre-commit: refusing to commit .env or auth.json"
    exit 1
fi

exit 0
