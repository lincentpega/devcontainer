#!/usr/bin/env bash
# Pre-commit guard: containerized gitleaks (no host installs).
# Requires Docker/OrbStack running at commit time. GitHub push protection is
# the server-side backstop for anything this misses.
#
# Installed via `git config core.hooksPath .githooks`.
set -u

# 1. Containerized gitleaks — full rule set (~150 rules + generic entropy)
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    if ! docker run --rm -v "$PWD:/repo" -w /repo zricethezav/gitleaks:latest protect --staged --redact; then
        echo "❌ pre-commit: gitleaks detected a possible secret in staged changes."
        exit 1
    fi
else
    echo "⚠️  pre-commit: Docker not available — gitleaks skipped (relies on GitHub push protection)."
fi

# 2. Filename policy (gitleaks doesn't guard filenames)
if git diff --cached --name-only | grep -qE '(^|/)\.env$|auth\.json$'; then
    echo "❌ pre-commit: refusing to commit .env or auth.json"
    exit 1
fi

exit 0
